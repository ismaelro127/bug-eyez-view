{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",

    "rootDir": ".",
    "outDir": "dist",

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "config/creditPackages.js",
    "services/creditService.js",
    "routes/payments.js",
    "services/mintCredits.js",
    "routes/credits.js",
    "routes/stripeWebhook.js",
    "models/CoinLedger.js",
    "models/CreditLedger.js",
    "models/UserBalance.js",
    "models/UserFeatures.js",
    "../frontend/pages/admin/adminLedger.js",
    "models/UnlockedChannel.js",
    "config/lockedChannels.js",
    "config/abuseThresholds.js",
    "coins/getBalance.js",
    "services/abuseDecay.js",
    "services/abuseEscalation.js",
    "services/abuseService.js",
    "services/abuseStats.js",
    "services/abuseTracker.js",
    "services/adFraudSignals.js",
    "services/adRewardGuard.js",
    "services/buildTxHash.js",
    "services/isAdShadowBanned.js",
    "services/recordAdAbuse.js",
    "services/spendCredits.js",
    "services/verifyLedger.js",
    "models/User.js",
    "routes/admin/stability.js",
    "lib/computeChannelStability.js",
    "lib/supabase.js",
    "routes/admin/insights.js",
    "routes/admin/persistStability.js",
    "services/persistChannelStability.js",
    "services/adminChannelInsights.js",
    "services/recordChannelPattern.js",
    "routes/events.js",
    "utils/logger.js"
  ],
  "exclude": ["node_modules", "dist"]
}